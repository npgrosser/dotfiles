# Dotfiles shared zsh config (managed by dotfiles repo)
# For machine-specific config, use ~/.zshrc_local

# Detect terminal background (dark/light) via OSC 11.
# Works over SSH since the query reaches the local terminal.
# Exported as TERM_BG for use by Neovim and other tools.
if [ -t 1 ] && [ -z "$TERM_BG" ]; then
  _oldstty=$(stty -g 2>/dev/null)
  stty raw -echo min 0 time 1 2>/dev/null
  printf '\e]11;?\e\\'
  IFS='' read -r -d '\' _response 2>/dev/null
  stty "$_oldstty" 2>/dev/null
  if [[ "$_response" =~ 'rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)' ]]; then
    _r=$((16#${match[1]:0:2}))
    _g=$((16#${match[2]:0:2}))
    _b=$((16#${match[3]:0:2}))
    _lum=$(( (_r * 299 + _g * 587 + _b * 114) / 1000 ))
    if (( _lum < 128 )); then
      export TERM_BG=dark
    else
      export TERM_BG=light
    fi
  fi
  unset _oldstty _response _r _g _b _lum
fi
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

export EDITOR="vim"
export VISUAL="vim"

# Shell aliases
alias t="tmux"
alias zj="zellij"
alias l='ls'
alias ll='ls -lah'
alias la='ls -A'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'
alias yolo='claude --dangerously-skip-permissions'
alias cld='claude --system-prompt "You are a general-purpose terminal and system assistant. Do not proactively explore the current directory or treat it as a project. Just help with whatever I ask."'

# open command (macOS-like wrapper around xdg-open)
if [[ "$(uname)" != "Darwin" ]]; then
  open() {
    local app="" reveal=0 textedit=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -a) app="$2"; shift 2 ;;
        -R) reveal=1; shift ;;
        -t) textedit=1; shift ;;
        *) break ;;
      esac
    done
    if (( textedit )); then
      ${EDITOR:-vi} "$@"
    elif (( reveal )); then
      local dir
      for f in "$@"; do
        dir="$(dirname "$(realpath "$f")")"
        xdg-open "$dir" &>/dev/null &
      done
    elif [[ -n "$app" ]]; then
      "$app" "$@" &>/dev/null &
    else
      local target
      for target in "${@:-.}"; do
        xdg-open "$target" &>/dev/null &
      done
    fi
  }
fi

# Use eza/bat if available
command -v eza >/dev/null 2>&1 && alias ls='eza --icons'
if command -v bat >/dev/null 2>&1; then
  export BAT_STYLE=plain
  alias cat='bat'
fi

# dot wrapper: intercept commands that need to affect the current shell
dot() {
  case "${1:-}" in
    reload)
      exec zsh
      ;;
    update)
      DOT_AUTO_RELOAD=1 command dot "$@" && exec zsh
      ;;
    *)
      command dot "$@"
      ;;
  esac
}

# z - jump around (https://github.com/rupa/z)
[ -f "$HOME/.local/share/z/z.sh" ] && . "$HOME/.local/share/z/z.sh"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# direnv hook
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# Machine-specific overrides (not managed by dotfiles)
[ -f "$HOME/.zshrc_local" ] && source "$HOME/.zshrc_local"
