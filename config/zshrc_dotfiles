# Dotfiles shared zsh config (managed by dotfiles repo)
# For machine-specific config, use ~/.zshrc_local

# Detect terminal background (dark/light) via OSC 11.
# sysread gives terminals that do not support the query a hard 150 ms timeout.
_dotfiles_detect_terminal_background() {
  [[ -t 0 && -t 1 ]] || return 0
  zmodload zsh/system 2>/dev/null || return 0

  local oldstty response
  local -a match
  oldstty=$(stty -g 2>/dev/null) || return 0

  {
    if stty raw -echo 2>/dev/null; then
      printf '\e]11;?\e\\'
      sysread -t 0.15 -s 64 response 2>/dev/null
    fi
  } always {
    stty "$oldstty" 2>/dev/null
  }

  if [[ "$response" =~ 'rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)' ]]; then
    local r=$((16#${match[1]:0:2}))
    local g=$((16#${match[2]:0:2}))
    local b=$((16#${match[3]:0:2}))
    local lum=$(( (r * 299 + g * 587 + b * 114) / 1000 ))
    if (( lum < 128 )); then
      export TERM_BG=dark
    else
      export TERM_BG=light
    fi
  fi
}

if [[ -z ${TERM_BG:-} ]]; then
  _dotfiles_detect_terminal_background
fi
unfunction _dotfiles_detect_terminal_background
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

export EDITOR="vim"
export VISUAL="vim"

# Shell aliases
alias t="tmux"
alias zj="zellij"
alias l='ls'
alias ll='ls -lah'
alias la='ls -A'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'
alias yolo='claude --dangerously-skip-permissions'
alias cld='claude --system-prompt "You are a general-purpose terminal and system assistant. Do not proactively explore the current directory or treat it as a project. Just help with whatever I ask."'

# open command (macOS-like wrapper for Linux and WSL)
if [[ "$(uname)" != "Darwin" ]]; then
  open() {
    local app="" reveal=0 textedit=0 is_wsl=0
    [[ -n "${WSL_INTEROP:-}" || "$(uname -r)" == *[Mm]icrosoft* ]] && is_wsl=1

    while [[ $# -gt 0 ]]; do
      case "$1" in
        -a) app="$2"; shift 2 ;;
        -R) reveal=1; shift ;;
        -t) textedit=1; shift ;;
        *) break ;;
      esac
    done

    if (( ! textedit )) && [[ -z "$app" ]]; then
      if (( is_wsl )); then
        command -v explorer.exe >/dev/null 2>&1 || {
          print -u2 "open: explorer.exe not found; is WSL interoperability enabled?"
          return 127
        }
        command -v wslpath >/dev/null 2>&1 || {
          print -u2 "open: wslpath not found"
          return 127
        }
      elif ! command -v xdg-open >/dev/null 2>&1; then
        print -u2 "open: xdg-open not found; install xdg-utils"
        return 127
      fi
    fi

    if (( textedit )); then
      ${EDITOR:-vi} "$@"
    elif (( reveal )); then
      local dir resolved windows_target
      for f in "$@"; do
        resolved="$(realpath -- "$f")" || return 1
        if (( is_wsl )); then
          windows_target="$(wslpath -w "$resolved")" || return 1
          explorer.exe "/select,$windows_target" &>/dev/null &!
        else
          dir="$(dirname "$resolved")"
          xdg-open "$dir" &>/dev/null &!
        fi
      done
    elif [[ -n "$app" ]]; then
      "$app" "$@" &>/dev/null &!
    else
      local target resolved windows_target
      for target in "${@:-.}"; do
        if (( is_wsl )); then
          if [[ "$target" == *://* || "$target" == mailto:* ]]; then
            windows_target="$target"
          else
            resolved="$(realpath -m -- "$target")" || return 1
            windows_target="$(wslpath -w "$resolved")" || return 1
          fi
          explorer.exe "$windows_target" &>/dev/null &!
        else
          xdg-open "$target" &>/dev/null &!
        fi
      done
    fi
  }
fi

# Use eza/bat if available
command -v eza >/dev/null 2>&1 && alias ls='eza --icons'
if command -v bat >/dev/null 2>&1; then
  export BAT_STYLE=plain
  alias cat='bat'
fi

# dot wrapper: intercept commands that need to affect the current shell
dot() {
  case "${1:-}" in
    reload)
      exec zsh
      ;;
    update)
      DOT_AUTO_RELOAD=1 command dot "$@" && exec zsh
      ;;
    *)
      command dot "$@"
      ;;
  esac
}

# z - jump around (https://github.com/rupa/z)
[ -f "$HOME/.local/share/z/z.sh" ] && . "$HOME/.local/share/z/z.sh"

# fnm - fast Node.js version manager
_fnm_dir="${XDG_DATA_HOME:-$HOME/.local/share}/fnm"
if [[ -x "$_fnm_dir/fnm" && ":$PATH:" != *":$_fnm_dir:"* ]]; then
  export PATH="$_fnm_dir:$PATH"
fi
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi
unset _fnm_dir

# direnv hook. Check the locations supported by this setup directly; searching
# the full PATH is noticeably slow in WSL when it contains Windows mounts.
_direnv_bin=""
for _candidate in \
  "$HOME/.local/bin/direnv" \
  /opt/homebrew/bin/direnv \
  /usr/local/bin/direnv \
  /usr/bin/direnv; do
  if [[ -x "$_candidate" ]]; then
    _direnv_bin="$_candidate"
    break
  fi
done
[[ -n "$_direnv_bin" ]] && eval "$("$_direnv_bin" hook zsh)"
unset _direnv_bin _candidate

# Machine-specific overrides (not managed by dotfiles)
[ -f "$HOME/.zshrc_local" ] && source "$HOME/.zshrc_local"
