config-file = ?config-platform

term = xterm-256color

font-family = "JetBrainsMono Nerd Font Mono"
font-style = Medium
theme = light:"GitHub Light High Contrast",dark:"GitHub Dark High Contrast"
unfocused-split-opacity = 1
split-divider-color = #bbbbbb
keybind = super+shift+left=goto_split:left
keybind = super+shift+down=goto_split:bottom
keybind = super+shift+up=goto_split:top
keybind = super+shift+right=goto_split:right
keybind = alt+shift+left=goto_split:left
keybind = alt+shift+down=goto_split:bottom
keybind = alt+shift+up=goto_split:top
keybind = alt+shift+right=goto_split:right
keybind = alt+d=new_split:right
keybind = alt+shift+d=new_split:down
