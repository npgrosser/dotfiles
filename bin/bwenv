#!/usr/bin/env bash
set -euo pipefail

# ─── Config ──────────────────────────────────────────────────────────
PREFIX="env/"
ENV_FILE=".env"
METADATA_SEP="# --- bwenv metadata ---"

# ─── Colors ──────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# ─── Helpers ─────────────────────────────────────────────────────────
die()  { echo -e "${RED}✗ $*${RESET}" >&2; exit 1; }
info() { echo -e "${CYAN}→ $*${RESET}"; }
warn() { echo -e "${YELLOW}⚠ $*${RESET}"; }
ok()   { echo -e "${GREEN}✓ $*${RESET}"; }

confirm() {
  local prompt="${1:-Continue?}"
  echo -en "${BOLD}${prompt} [y/N]${RESET} "
  read -r answer
  [[ "$answer" =~ ^[Yy]$ ]]
}

# ─── Session handling ────────────────────────────────────────────────
ensure_session() {
  if [ -z "${BW_SESSION:-}" ]; then
    if bw status 2>/dev/null | jq -e '.status == "unlocked"' &>/dev/null; then
      return 0
    fi
    info "Bitwarden is locked. Unlocking..."
    BW_SESSION=$(bw unlock --raw) || die "Unlock failed"
    export BW_SESSION
  fi

  # Verify session is valid
  if ! bw status 2>/dev/null | jq -e '.status == "unlocked"' &>/dev/null; then
    info "Session expired. Re-unlocking..."
    BW_SESSION=$(bw unlock --raw) || die "Unlock failed"
    export BW_SESSION
  fi

  bw sync --quiet 2>/dev/null || true
}

# ─── Project name detection ─────────────────────────────────────────
detect_project() {
  # Try git remote first (e.g. "github.com:user/myproject.git" → "myproject")
  local remote
  if remote=$(git remote get-url origin 2>/dev/null); then
    basename -s .git "$remote"
    return
  fi

  # Fallback: current directory name
  basename "$PWD"
}

# ─── Item name from project name ────────────────────────────────────
item_name() {
  echo "${PREFIX}${1}"
}

# ─── Build metadata block ───────────────────────────────────────────
build_metadata() {
  local project="$1"
  cat <<EOF
${METADATA_SEP}
# project: ${project}
# pushed_from: ${PWD}
# pushed_at: $(date -u '+%Y-%m-%d %H:%M:%S UTC')
# hostname: $(hostname)
EOF
}

# ─── Strip metadata from note content ───────────────────────────────
strip_metadata() {
  sed "/${METADATA_SEP}/,\$d" | sed -e :a -e '/^\n*$/{$d;N;ba;}'
}

# ─── Get item from Bitwarden (returns empty string if not found) ────
bw_get_item() {
  local name="$1"
  bw get item "$name" 2>/dev/null || echo ""
}

# ─── Show diff between two strings ──────────────────────────────────
show_diff() {
  local label_a="$1" content_a="$2" label_b="$3" content_b="$4"
  echo ""
  diff --color=always -u \
    <(echo "$content_a") \
    <(echo "$content_b") \
    --label "$label_a" \
    --label "$label_b" \
  || true  # diff returns 1 when files differ
  echo ""
}

# ─── PUSH ────────────────────────────────────────────────────────────
cmd_push() {
  local project="${1:-$(detect_project)}"
  local name
  name=$(item_name "$project")

  [ -f "$ENV_FILE" ] || die "No ${ENV_FILE} in current directory"

  info "Project: ${BOLD}${project}${RESET}"
  info "Item:    ${BOLD}${name}${RESET}"
  info "Source:  ${PWD}/${ENV_FILE}"
  echo ""

  local local_content
  local_content=$(cat "$ENV_FILE")

  # Check if item already exists
  local existing
  existing=$(bw_get_item "$name")

  if [ -n "$existing" ]; then
    local remote_content
    remote_content=$(echo "$existing" | jq -r '.notes // ""' | strip_metadata)

    if [ "$local_content" = "$remote_content" ]; then
      ok "Already in sync – nothing to push."
      return 0
    fi

    warn "Item ${BOLD}${name}${RESET} already exists in Bitwarden!"
    info "Diff (Bitwarden → local):"
    show_diff "bitwarden" "$remote_content" "local" "$local_content"

    # Extra safety: check stored path
    local stored_path
    stored_path=$(echo "$existing" | jq -r '.notes // ""' | grep "^# pushed_from:" | sed 's/^# pushed_from: //' || true)
    if [ -n "$stored_path" ] && [ "$stored_path" != "$PWD" ]; then
      warn "Last push was from a different directory: ${BOLD}${stored_path}${RESET}"
    fi

    confirm "Overwrite Bitwarden item?" || { info "Aborted."; return 1; }

    # Update existing item
    local item_id
    item_id=$(echo "$existing" | jq -r '.id')
    local note_content="${local_content}

$(build_metadata "$project")"

    echo "$existing" | jq --arg notes "$note_content" '.notes = $notes' \
      | bw encode | bw edit item "$item_id" > /dev/null

    ok "Pushed ${ENV_FILE} → ${name}"
  else
    info "Creating new Bitwarden item..."
    confirm "Create item ${BOLD}${name}${RESET}?" || { info "Aborted."; return 1; }

    local note_content="${local_content}

$(build_metadata "$project")"

    bw get template item | jq \
      --arg name "$name" \
      --arg notes "$note_content" \
      '.type = 2 | .secureNote = {"type": 0} | .name = $name | .notes = $notes' \
      | bw encode | bw create item > /dev/null

    ok "Created ${name} with ${ENV_FILE}"
  fi
}

# ─── PULL ────────────────────────────────────────────────────────────
cmd_pull() {
  local project="${1:-$(detect_project)}"
  local name
  name=$(item_name "$project")

  info "Project: ${BOLD}${project}${RESET}"
  info "Item:    ${BOLD}${name}${RESET}"
  info "Target:  ${PWD}/${ENV_FILE}"
  echo ""

  local existing
  existing=$(bw_get_item "$name")
  [ -n "$existing" ] || die "Item ${name} not found in Bitwarden"

  local remote_content
  remote_content=$(echo "$existing" | jq -r '.notes // ""' | strip_metadata)

  [ -n "$remote_content" ] || die "Item ${name} has no content"

  # Check stored path
  local stored_path
  stored_path=$(echo "$existing" | jq -r '.notes // ""' | grep "^# pushed_from:" | sed 's/^# pushed_from: //' || true)
  if [ -n "$stored_path" ] && [ "$stored_path" != "$PWD" ]; then
    warn "This .env was pushed from: ${BOLD}${stored_path}${RESET}"
    warn "You are pulling into:      ${BOLD}${PWD}${RESET}"
    confirm "Continue anyway?" || { info "Aborted."; return 1; }
  fi

  if [ -f "$ENV_FILE" ]; then
    local local_content
    local_content=$(cat "$ENV_FILE")

    if [ "$local_content" = "$remote_content" ]; then
      ok "Already in sync – nothing to pull."
      return 0
    fi

    warn "Local ${ENV_FILE} will be overwritten!"
    info "Diff (local → Bitwarden):"
    show_diff "local (.env)" "$local_content" "bitwarden" "$remote_content"

    confirm "Overwrite local ${ENV_FILE}?" || { info "Aborted."; return 1; }
  fi

  echo "$remote_content" > "$ENV_FILE"
  ok "Pulled ${name} → ${ENV_FILE}"
}

# ─── LIST ────────────────────────────────────────────────────────────
cmd_list() {
  info "Searching for ${PREFIX}* items..."
  echo ""

  local items
  items=$(bw list items --search "$PREFIX" 2>/dev/null)

  if [ -z "$items" ] || [ "$items" = "[]" ]; then
    warn "No ${PREFIX}* items found."
    return 0
  fi

  echo "$items" | jq -r --arg prefix "$PREFIX" '
    .[] | select(.name | startswith($prefix)) |
    .name as $name | .notes // "" |
    {
      name: ($name | ltrimstr($prefix)),
      item: $name,
      pushed: (split("\n") | map(select(startswith("# pushed_at:"))) | first // "unknown" | ltrimstr("# pushed_at: ")),
      from: (split("\n") | map(select(startswith("# pushed_from:"))) | first // "unknown" | ltrimstr("# pushed_from: "))
    } |
    "  \(.name)\t\(.pushed)\t\(.from)"
  ' | column -t -s $'\t' -N "PROJECT,LAST PUSH,FROM" 2>/dev/null \
    || echo "$items" | jq -r --arg prefix "$PREFIX" '
      .[] | select(.name | startswith($prefix)) | "  \(.name | ltrimstr($prefix))"
    '
}

# ─── DIFF ────────────────────────────────────────────────────────────
cmd_diff() {
  local project="${1:-$(detect_project)}"
  local name
  name=$(item_name "$project")

  [ -f "$ENV_FILE" ] || die "No ${ENV_FILE} in current directory"

  local existing
  existing=$(bw_get_item "$name")
  [ -n "$existing" ] || die "Item ${name} not found in Bitwarden"

  local remote_content
  remote_content=$(echo "$existing" | jq -r '.notes // ""' | strip_metadata)
  local local_content
  local_content=$(cat "$ENV_FILE")

  if [ "$local_content" = "$remote_content" ]; then
    ok "${project}: in sync ✓"
  else
    info "${project}: local ↔ Bitwarden differ:"
    show_diff "local (.env)" "$local_content" "bitwarden" "$remote_content"
  fi
}

# ─── Usage ───────────────────────────────────────────────────────────
usage() {
  cat <<EOF
${BOLD}bwenv${RESET} – Sync .env files via Bitwarden CLI

${BOLD}Usage:${RESET}
  bwenv push [project]    Push local .env to Bitwarden
  bwenv pull [project]    Pull .env from Bitwarden
  bwenv diff [project]    Show diff between local and Bitwarden
  bwenv list              List all stored .env items

${BOLD}Project name:${RESET}
  Auto-detected from git remote or directory name.
  Override by passing it explicitly: bwenv push myproject

${BOLD}Items are stored as:${RESET}
  ${PREFIX}<project>  (Secure Note in Bitwarden)

${BOLD}Examples:${RESET}
  cd ~/projects/myapp
  bwenv push              # .env → Bitwarden (as ${PREFIX}myapp)
  bwenv pull              # Bitwarden → .env
  bwenv diff              # compare local vs Bitwarden
  bwenv list              # show all stored envs
EOF
}

# ─── Main ────────────────────────────────────────────────────────────
main() {
  command -v bw &>/dev/null || die "Bitwarden CLI (bw) not found. Install: https://bitwarden.com/help/cli/"
  command -v jq &>/dev/null || die "jq not found."

  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    push|pull|diff|list)
      ensure_session
      "cmd_${cmd}" "$@"
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      die "Unknown command: ${cmd}\nRun 'bwenv --help' for usage."
      ;;
  esac
}

main "$@"
