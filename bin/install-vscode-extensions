#!/usr/bin/env bash
set -euo pipefail

EXT_FILE="$HOME/.config/dotfiles/vscode-extensions.txt"

if ! command -v code >/dev/null 2>&1; then
  echo "Error: 'code' command not found. Is VS Code installed?"
  exit 1
fi

if [ ! -f "$EXT_FILE" ]; then
  echo "Error: extensions list not found at $EXT_FILE"
  echo "       re-run dotfiles install.sh to populate it"
  exit 1
fi

echo "==> Installing VS Code extensions..."
while IFS= read -r ext || [ -n "$ext" ]; do
  ext="$(echo "$ext" | xargs)"
  [ -z "$ext" ] && continue
  [[ "$ext" == \#* ]] && continue
  echo "  - $ext"
  code --install-extension "$ext" --force 2>/dev/null || echo "    (failed)"
done < "$EXT_FILE"

echo "==> Done."
