#!/usr/bin/env bash
set -euo pipefail

SELF="$(dirname "$(realpath "$0")")"

usage() {
  cat <<'HELP'
Usage: dot <command> [args...]

Commands:
  update                 Update dotfiles from GitHub to the latest version
  add <package>          Install additional optional tools (rust, gcloud, cursor)
  install-vscode-ext     Install VS Code extensions from config
  help                   Show this help message
HELP
}

if [ "$#" -eq 0 ]; then usage; exit 1; fi
COMMAND="$1"
shift

cmd_update() {
  if [ "${1:-}" = "--force" ] || [ "${1:-}" = "-f" ]; then
    export FORCE_REINSTALL=1
  fi
  exec curl -fsSL https://raw.githubusercontent.com/npgrosser/dotfiles/refs/heads/main/install.sh | bash
}

cmd_add() {
  MK="$SELF/.dot.mk"

  usage_add() {
    cat <<'HELP'
Usage:
  dot add <package> [package...]
  dot add all
  dot add list

Packages:
  rust      Rust toolchain (via rustup)
  gcloud    Google Cloud CLI
  cursor    Cursor CLI
HELP
  }

  _have() {
    case "$1" in
      rust)   command -v rustc  >/dev/null 2>&1 || [ -x "$HOME/.cargo/bin/rustc" ] ;;
      gcloud) command -v gcloud >/dev/null 2>&1 || [ -d "$HOME/google-cloud-sdk" ] ;;
      cursor) command -v cursor >/dev/null 2>&1 || [ -x "$HOME/.local/bin/cursor" ] ;;
    esac
  }

  list_packages() {
    for pkg in rust gcloud cursor; do
      if _have "$pkg"; then
        printf "%-8s installed\n" "$pkg:"
      else
        printf "%-8s not installed\n" "$pkg:"
      fi
    done
  }

  if [ "$#" -lt 1 ]; then usage_add; exit 1; fi

  case "$1" in
    list)            list_packages ;;
    -h|--help|help)  usage_add ;;
    *)               exec make -j --no-print-directory -f "$MK" "$@" ;;
  esac
}

cmd_install_vscode_ext() {
  EXT_FILE="$HOME/.config/dotfiles/vscode-extensions.txt"

  if ! command -v code >/dev/null 2>&1; then
    echo "Error: 'code' command not found. Is VS Code installed?"
    exit 1
  fi

  if [ ! -f "$EXT_FILE" ]; then
    echo "Error: extensions list not found at $EXT_FILE"
    echo "       re-run dotfiles install.sh to populate it"
    exit 1
  fi

  # Detect remote environment (Codespaces, SSH, Dev Container)
  is_remote=false
  if [[ -n "${CODESPACES:-}" ]] || [[ -n "${REMOTE_CONTAINERS:-}" ]] || [[ -n "${SSH_CONNECTION:-}" ]]; then
    is_remote=true
  fi

  # Build argument list
  args=()
  skipped=()
  while IFS= read -r ext || [ -n "$ext" ]; do
    ext="$(echo "$ext" | xargs)"
    [ -z "$ext" ] && continue
    [[ "$ext" == \#* ]] && continue

    if $is_remote && [[ "$ext" == ms-vscode-remote.remote-* ]]; then
      skipped+=("$ext")
      continue
    fi

    args+=(--install-extension "$ext")
  done < "$EXT_FILE"

  echo "==> Installing VS Code extensions..."

  for s in "${skipped[@]+"${skipped[@]}"}"; do
    echo "  skip $s (remote environment)"
  done

  if [ ${#args[@]} -gt 0 ]; then
    code --force "${args[@]}"
  fi

  echo "==> Done."
}

case "$COMMAND" in
  update)                  cmd_update "$@" ;;
  add)                     cmd_add "$@" ;;
  install-vscode-ext)      cmd_install_vscode_ext "$@" ;;
  help|-h|--help)          usage ;;
  *)                       echo "Unknown command: $COMMAND"; usage; exit 1 ;;
esac
