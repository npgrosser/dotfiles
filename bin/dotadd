#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  dotadd <package>
  dotadd all
  dotadd list

Packages:
  claude    Claude CLI
  node      Node.js (via nvm)
  uv        Python package manager
  rust      Rust toolchain (via rustup)
  gcloud    Google Cloud CLI
EOF
}

have_claude() {
  command -v claude >/dev/null 2>&1 || [ -x "$HOME/.local/bin/claude" ]
}

have_node() {
  command -v node >/dev/null 2>&1
}

have_uv() {
  command -v uv >/dev/null 2>&1 || [ -x "$HOME/.local/bin/uv" ]
}

have_rust() {
  command -v rustc >/dev/null 2>&1 || [ -x "$HOME/.cargo/bin/rustc" ]
}

have_gcloud() {
  command -v gcloud >/dev/null 2>&1 || [ -d "$HOME/google-cloud-sdk" ]
}

add_claude() {
  if have_claude; then
    echo "claude: already installed"
    return
  fi
  echo "claude: installing..."
  curl -fsSL https://claude.ai/install.sh | bash
}

add_node() {
  if have_node; then
    echo "node: already installed"
    return
  fi
  if [ ! -s "$HOME/.nvm/nvm.sh" ]; then
    echo "node: installing nvm..."
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh | bash
  fi
  export NVM_DIR="$HOME/.nvm"
  . "$NVM_DIR/nvm.sh"
  echo "node: installing latest..."
  nvm install node
}

add_uv() {
  if have_uv; then
    echo "uv: already installed"
    return
  fi
  echo "uv: installing..."
  curl -LsSf https://astral.sh/uv/install.sh | sh
}

add_rust() {
  if have_rust; then
    echo "rust: already installed"
    return
  fi
  echo "rust: installing..."
  curl -fsSL https://sh.rustup.rs | sh -s -- -y
}

add_gcloud() {
  if have_gcloud; then
    echo "gcloud: already installed"
    return
  fi
  echo "gcloud: installing..."
  curl -fsSL https://sdk.cloud.google.com | bash -s -- --disable-prompts
}

list_packages() {
  if have_claude; then echo "claude: installed"; else echo "claude: not installed"; fi
  if have_node; then echo "node: installed"; else echo "node: not installed"; fi
  if have_uv; then echo "uv: installed"; else echo "uv: not installed"; fi
  if have_rust; then echo "rust: installed"; else echo "rust: not installed"; fi
  if have_gcloud; then echo "gcloud: installed"; else echo "gcloud: not installed"; fi
}

if [ "$#" -lt 1 ]; then
  usage
  exit 1
fi

case "$1" in
  claude) add_claude ;;
  node) add_node ;;
  uv) add_uv ;;
  rust) add_rust ;;
  gcloud) add_gcloud ;;
  all)
    add_claude
    add_node
    add_uv
    add_rust
    add_gcloud
    ;;
  list)
    list_packages
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown package: $1"
    usage
    exit 1
    ;;
esac
